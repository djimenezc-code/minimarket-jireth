<!DOCTYPE html>
<html>
<head>
    <title>Redirigiendo a Webpay...</title>
</head>
<body onload="document.forms['webpay'].submit()">
    <h2 style="font-family: sans-serif; text-align: center; margin-top: 100px;">
        Conectando de forma segura con Webpay Plus...
    </h2>
    <form name="webpay" action="<%= url %>" method="POST">
        <input type="hidden" name="token_ws" value="<%= token %>" />
    </form>
</body>
</html>