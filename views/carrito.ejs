<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Checkout | Minimarket Jireth</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #0f172a; color: white; }
        .table { color: white; }
        .btn-qty { width: 35px; height: 35px; border-radius: 50%; padding: 0; }
    </style>
</head>
<body>
    <div class="container my-5">
        <h2 class="mb-4 fw-bold text-success">Mi Carrito de Compras</h2>
        <div class="card bg-dark border-secondary shadow">
            <div class="card-body">
                <% if (carrito.length > 0) { %>
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let total = 0; %>
                            <% carrito.forEach(item => { %>
                                <tr>
                                    <td><%= item.nombre %></td>
                                    <td>$<%= item.precio %></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-light btn-qty" onclick="updateQty('<%= item.id %>', 'restar')">-</button>
                                        <span class="mx-3 fw-bold"><%= item.cantidad %></span>
                                        <button class="btn btn-sm btn-outline-light btn-qty" onclick="updateQty('<%= item.id %>', 'sumar')">+</button>
                                    </td>
                                    <td class="text-end">$<%= item.precio * item.cantidad %></td>
                                </tr>
                                <% total += item.precio * item.cantidad; %>
                            <% }) %>
                        </tbody>
                    </table>
                    <div class="text-end mt-4">
                        <h3>Total: <span class="text-success">$<%= total %></span></h3>
                        <form action="/webpay/pagar" method="POST" class="mt-3">
                            <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow">
                                PAGAR CON WEBPAY 💳
                            </button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <p>El carrito está vacío</p>
                        <a href="/" class="btn btn-outline-success">Ir a comprar</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function updateQty(id, accion) {
            fetch('/carrito/update', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, accion })
            }).then(() => location.reload());
        }
    </script>
</body>
</html>