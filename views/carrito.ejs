<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Carrito | Jireth Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/estilos_menu.css">
    <style>
        body { background-color: #f8fafc; font-family: 'Plus Jakarta Sans', sans-serif; }
        .cart-container { background: white; border-radius: 24px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        .btn-pay { background: #10b981; color: white; border-radius: 12px; font-weight: 700; padding: 15px; border: none; }
        .btn-pay:hover { background: #059669; }
        .search-bar { position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: white; padding: 10px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); display: none; z-index: 1002; }
        .search-bar.active { display: flex; gap: 10px; }
    </style>
</head>
<body>

<!-- MENÚ HAMBURGUESA -->
<div id="menu-toggle" class="hamburger-btn">
    <span></span>
    <span></span>
    <span></span>
</div>

<nav id="side-menu" class="side-drawer">
    <div class="menu-header">
        <h2>Jireth<span>Store</span></h2>
    </div>

    <ul class="menu-links">
        <li><a href="/"><i class="fas fa-home"></i> Inicio</a></li>
        <li><a href="#" onclick="toggleSearch()"><i class="fas fa-search"></i> Buscar Producto</a></li>
        <li><a href="#" onclick="showCategories()"><i class="fas fa-th-large"></i> Categorías</a></li>
        <% if (typeof user !== 'undefined' && user) { %>
            <li><a href="/carrito"><i class="fas fa-shopping-cart"></i> Mi Carrito (<%= typeof cantidad !== 'undefined' ? cantidad : 0 %>)</a></li>
            <li><a href="#"><i class="fas fa-user"></i> Mi Perfil</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</a></li>
        <% } else { %>
            <li><a href="/login"><i class="fas fa-sign-in-alt"></i> Iniciar Sesión</a></li>
            <li><a href="/registro"><i class="fas fa-user-plus"></i> Registrarse</a></li>
        <% } %>
        <li><a href="https://wa.me/56948539049" target="_blank"><i class="fab fa-whatsapp"></i> WhatsApp</a></li>
        <li><a href="mailto:contacto@jireth.cl"><i class="fas fa-envelope"></i> Contacto</a></li>
    </ul>
</nav>

<div id="overlay" class="menu-overlay"></div>

<!-- BARRA DE BÚSQUEDA OCULTA -->
<div id="search-bar" class="search-bar">
    <input type="text" id="search-input" placeholder="Buscar productos..." class="form-control">
    <button onclick="performSearch()" class="btn btn-primary">Buscar</button>
</div>
    <div class="container">
        <div class="cart-container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold m-0">🛒 Tu Carrito</h2>
                <a href="/" class="btn btn-outline-secondary rounded-pill">Seguir Comprando</a>
            </div>

            <% if (carrito.length > 0) { %>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th class="text-center">Cantidad</th>
                                <th>Subtotal</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let total = 0; %>
                            <% carrito.forEach(item => { 
                                let subtotal = item.precio * item.cantidad;
                                total += subtotal;
                            %>
                                <tr>
                                    <td class="fw-bold"><%= item.nombre %></td>
                                    <td>$<%= item.precio %></td>
                                    <td class="text-center">
                                        <div class="btn-group border rounded-pill overflow-hidden">
                                            <button class="btn btn-sm btn-light px-3" onclick="updateQty('<%= item.id %>', 'restar')">-</button>
                                            <span class="px-3 py-1 bg-white fw-bold"><%= item.cantidad %></span>
                                            <button class="btn btn-sm btn-light px-3" onclick="updateQty('<%= item.id %>', 'sumar')">+</button>
                                        </div>
                                    </td>
                                    <td class="fw-bold text-success">$<%= subtotal %></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger border-0" onclick="updateQty('<%= item.id %>', 'eliminar')">🗑️</button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="row mt-5 pt-4 border-top">
                    <div class="col-md-6 offset-md-6 text-end">
                        <p class="text-muted mb-1">Total a pagar:</p>
                        <h1 class="fw-extrabold mb-4">$<%= total %></h1>
                        
                        <form action="/webpay/pagar" method="POST">
                            <button type="submit" class="btn-pay w-100 fs-5 shadow">Pagar con Webpay Plus</button>
                        </form>
                    </div>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <p class="fs-4 text-muted">Tu carrito está vacío.</p>
                    <a href="/" class="btn btn-success px-5 py-3 rounded-pill fw-bold">Ver Productos</a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function updateQty(id, accion) {
            fetch('/carrito/update', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, accion })
            }).then(() => location.reload());
        }

        // MENÚ HAMBURGUESA
        const menuToggle = document.getElementById('menu-toggle');
        const sideMenu = document.getElementById('side-menu');
        const overlay = document.getElementById('overlay');

        function toggleMenu() {
            sideMenu.classList.toggle('active');
            overlay.classList.toggle('active');
        }

        menuToggle.addEventListener('click', toggleMenu);
        overlay.addEventListener('click', toggleMenu);

        // BÚSQUEDA
        function toggleSearch() {
            const searchBar = document.getElementById('search-bar');
            searchBar.classList.toggle('active');
            if (searchBar.classList.contains('active')) {
                document.getElementById('search-input').focus();
            }
        }

        function performSearch() {
            const query = document.getElementById('search-input').value;
            if (query) {
                window.location.href = '/?search=' + encodeURIComponent(query);
            }
        }

        // CATEGORÍAS
        function showCategories() {
            alert('Categorías disponibles: Abarrotes, Lácteos, Limpieza, Snacks. ¡Próximamente filtros avanzados!');
        }
    </script>
</body>
</html>