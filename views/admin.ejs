<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard | Jireth</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f1f5f9; font-family: sans-serif; }
        .sidebar { background: #1e293b; min-height: 100vh; color: white; }
        .card-stats { border: none; border-left: 5px solid #10b981; }
        .table-container { background: white; border-radius: 15px; padding: 20px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar p-4">
                <h4 class="fw-bold text-success mb-5">JIRETH ADMIN</h4>
                <ul class="nav flex-column gap-3">
                    <li class="nav-item"><a href="/" class="nav-link text-white opacity-75">🏪 Ver Tienda</a></li>
                    <li class="nav-item"><a href="/admin" class="nav-link text-white fw-bold">📦 Inventario</a></li>
                </ul>
            </div>

            <div class="col-md-10 p-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold">Gestión de Productos</h2>
                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalAgregar">+ Nuevo Producto</button>
                </div>

                <div class="table-container">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Imagen</th>
                                <th>Nombre</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% productos.forEach(p => { %>
                                <tr>
                                    <td><img src="<%= p.imagen %>" width="40" height="40" class="rounded-circle" style="object-fit: cover;"></td>
                                    <td class="fw-bold"><%= p.nombre %></td>
                                    <td>
                                        <input type="number" value="<%= p.precio %>" class="form-control form-control-sm d-inline-block w-75" id="p-<%= p.id %>">
                                    </td>
                                    <td>
                                        <input type="number" value="<%= p.stock %>" class="form-control form-control-sm d-inline-block w-50" id="s-<%= p.id %>">
                                    </td>
                                    <td>
                                        <button onclick="updateItem('<%= p.id %>')" class="btn btn-sm btn-primary">💾</button>
                                        <a href="/admin/eliminar/<%= p.id %>" class="btn btn-sm btn-outline-danger">🗑️</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAgregar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/admin/agregar" method="POST">
                    <div class="modal-header"><h5>Agregar Producto</h5></div>
                    <div class="modal-body">
                        <input type="text" name="nombre" placeholder="Nombre" class="form-control mb-3" required>
                        <input type="text" name="categoria" placeholder="Categoría (Bebidas, Aseo...)" class="form-control mb-3">
                        <input type="number" name="precio" placeholder="Precio" class="form-control mb-3" required>
                        <input type="number" name="stock" placeholder="Stock" class="form-control mb-3" required>
                        <input type="text" name="imagen" placeholder="URL de la imagen" class="form-control">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-success">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateItem(id) {
            const precio = document.getElementById('p-' + id).value;
            const stock = document.getElementById('s-' + id).value;
            fetch('/admin/editar', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, precio, stock })
            }).then(() => alert('Actualizado correctamente'));
        }
    </script>
</body>
</html>