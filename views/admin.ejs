<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Admin Panel | Jireth Tech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #0f172a; color: #e2e8f0; }
        .card { background: #1e293b; border: none; }
        .table { color: #e2e8f0; }
        .form-control { background: #334155; border: 1px solid #475569; color: white; }
        .form-control:focus { background: #334155; color: white; }
    </style>
</head>
<body class="p-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-success fw-bold">⚙️ Gestión de Inventario</h1>
            <a href="/" class="btn btn-outline-light">Ver Tienda</a>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="card p-3 shadow">
                    <h5 class="text-success">Registrar Producto</h5>
                    <form action="/admin/agregar" method="POST">
                        <input type="text" name="nombre" placeholder="Nombre" class="form-control mb-2" required>
                        <input type="text" name="categoria" placeholder="Categoría" class="form-control mb-2">
                        <input type="number" name="precio" placeholder="Precio ($)" class="form-control mb-2" required>
                        <input type="number" name="stock" placeholder="Stock Inicial" class="form-control mb-2" required>
                        <input type="text" name="imagen" placeholder="URL Imagen" class="form-control mb-2">
                        <button type="submit" class="btn btn-success w-100">Guardar en DB</button>
                    </form>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card p-3 shadow">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Precio Actual</th>
                                <th>Stock</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% productos.forEach(p => { %>
                                <tr id="row-<%= p.id %>">
                                    <td><strong><%= p.nombre %></strong></td>
                                    <td><input type="number" value="<%= p.precio %>" class="form-control form-control-sm" id="p-<%= p.id %>"></td>
                                    <td><input type="number" value="<%= p.stock %>" class="form-control form-control-sm" id="s-<%= p.id %>"></td>
                                    <td>
                                        <button onclick="saveChanges('<%= p.id %>')" class="btn btn-sm btn-primary">💾</button>
                                        <a href="/admin/eliminar/<%= p.id %>" class="btn btn-sm btn-danger">🗑️</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function saveChanges(id) {
            const precio = document.getElementById('p-' + id).value;
            const stock = document.getElementById('s-' + id).value;

            fetch('/admin/editar', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, precio, stock })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) alert("Producto " + id + " actualizado correctamente.");
            });
        }
    </script>
</body>
</html>