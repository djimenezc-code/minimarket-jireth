<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimarket Jireth | Premium Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #10b981; --dark: #0f172a; --light-bg: #f8fafc; }
        body { background-color: var(--light-bg); font-family: 'Plus Jakarta Sans', sans-serif; color: var(--dark); }
        .navbar { background: rgba(255, 255, 255, 0.8) !important; backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,0,0,0.05); }
        .navbar-brand { font-weight: 800; letter-spacing: -1px; color: var(--primary) !important; }
        .card-product { background: white; border: 1px solid rgba(0,0,0,0.05); border-radius: 20px; transition: all 0.4s ease; }
        .card-product:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); }
        .img-container { height: 220px; overflow: hidden; border-radius: 15px; margin: 10px; }
        .img-container img { width: 100%; height: 100%; object-fit: cover; }
        .btn-add { background: var(--dark); color: white; border: none; border-radius: 12px; font-weight: 600; padding: 10px 20px; }
        .btn-add:hover { background: var(--primary); color: white; }
        .footer-tech { background: white; border-top: 1px solid rgba(0,0,0,0.05); padding: 80px 0 40px; margin-top: 100px; }
        .map-container { border-radius: 24px; overflow: hidden; border: 5px solid white; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg sticky-top py-3">
        <div class="container">
            <a class="navbar-brand fs-3" href="/">JIRETH<span class="text-dark">STORE</span></a>
            
            <div class="d-flex align-items-center gap-2">
                <% if (user) { %>
                    <span class="me-2 fw-bold text-dark">👋 Hola, <span class="text-success"><%= user %></span></span>
                    <a href="/logout" class="btn btn-sm btn-outline-danger rounded-pill px-3">Salir</a>
                <% } else { %>
                    <a href="/login" class="btn btn-link text-dark text-decoration-none fw-600">Entrar</a>
                    <a href="/registro" class="btn btn-dark rounded-pill px-4 shadow-sm">Registrarse</a>
                <% } %>
                
                <a href="/carrito" class="ms-3 btn btn-light rounded-circle shadow-sm position-relative p-2" style="width: 45px; height: 45px; text-decoration: none; display: flex; align-items: center; justify-content: center;">
                    🛒
                    <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <%= cantidad %>
                    </span>
                </a>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="row g-4">
            <% productos.forEach(function(prod) { %>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card-product h-100 d-flex flex-column">
                        <div class="img-container">
                            <img src="<%= prod.imagen %>" 
                            alt="<%= prod.nombre %>" 
                            onerror="this.onerror=null; this.src='https://placehold.co/400x400?text=Jireth+Store';">
                        </div>
                        <div class="p-4 pt-0 mt-auto">
                            <small class="text-success fw-bold text-uppercase" style="font-size: 10px;"><%= prod.categoria %></small>
                            <h5 class="fw-bold mb-1"><%= prod.nombre %></h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fs-4 fw-bold text-dark">$<%= prod.precio %></span>
                                <button class="btn-add" onclick="add('<%= prod.id %>', '<%= prod.nombre %>', '<%= prod.precio %>')">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>

    <footer class="footer-tech">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-5 mb-5 mb-lg-0">
                    <h2 class="fw-bold mb-4">Estamos para <br><span class="text-success">servirte.</span></h2>
                    <p>📍 <strong>Dirección:</strong> <%= info.direccion %></p>
                    <p>⏰ <strong>Horario:</strong> <%= info.horario %></p>
                    <p>📞 <strong>Llámanos:</strong> <%= info.telefono %></p>
                    </div>
                <div class="col-lg-7">
                    <div class="map-container">
                        <iframe src="<%= info.mapa %>" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                </div>
            </div>
            <div class="mt-5 pt-5 border-top text-center text-muted small">
                &copy; 2026 Minimarket Jireth | <a href="/admin" class="text-decoration-none text-muted">Panel Admin</a>
            </div>
        </div>
    </footer>

    <script>
        function add(id, nombre, precio) {
            fetch('/agregar-al-carrito', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, nombre, precio })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('cart-count').innerText = data.cantidad;
            });
        }
    </script>
</body>
</html>