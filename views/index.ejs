<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Minimarket Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4 shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🛒 Minimarket Jireth</a>
            <div class="d-flex align-items-center">
                <span class="badge bg-warning text-dark me-3">Carrito: <span id="cart-count">0</span></span>
                <a href="/login" class="btn btn-outline-light btn-sm me-2">Entrar</a>
                <a href="/registro" class="btn btn-light btn-sm text-success fw-bold">Registrarse</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <% productos.forEach(function(prod) { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="<%= prod.imagen %>" class="card-img-top" alt="<%= prod.nombre %>" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold"><%= prod.nombre %></h5>
                            <p class="text-muted small"><%= prod.categoria %></p>
                            <h4 class="text-success">$<%= prod.precio %></h4>
                            <p class="text-secondary small">Disponible: <%= prod.stock %></p>
                            
                            <button class="btn btn-outline-success w-100 mt-2" onclick="agregarAlCarrito('<%= prod.nombre %>')">
                                🛒 Agregar al pedido
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <script>
        let count = 0;
        function agregarAlCarrito(nombre) {
            count++;
            document.getElementById('cart-count').innerText = count;
            alert(nombre + " agregado correctamente");
        }
    </script>
</body>
</html>