<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimarket Jireth | Premium Store</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        :root { 
            --primary: #10b981; /* Verde Esmeralda */
            --dark: #0f172a;
        }

        body { 
            background-color: var(--light-bg); 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            color: var(--dark); 
        }

        /* Navbar Superior */
        .navbar { 
            background: rgba(255, 255, 255, 0.9); 
            backdrop-filter: blur(12px); 
            border-bottom: 2px solid var(--primary);
            padding: 15px 0;
        }

        .navbar-brand { color: var(--primary); }

        /* Botón de Menú (3 rayas) */
        .menu-btn {
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 10px;
        }

        .menu-btn span {
            width: 25px;
            height: 3px;
            background: var(--dark);
            border-radius: 5px;
            transition: 0.3s;
        }

        /* Lista Desplegable */
        .dropdown-content {
            display: none;
            position: absolute;
            right: 20px;
            top: 70px;
            background: white;
            min-width: 200px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border-radius: 15px;
            z-index: 1000;
            overflow: hidden;
        }

        .dropdown-content.show { display: block; animation: fadeIn 0.3s; }

        .dropdown-content a {
            color: var(--dark);
            padding: 12px 20px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: 0.2s;
        }

        .dropdown-content a:hover { background: #f0fdf4; color: var(--primary); }

        /* Tarjetas de Productos */
        .product-card {
            background: white;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.05);
            transition: 0.3s;
            overflow: hidden;
        }

        .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }

        .img-box { height: 200px; background: #eee; }
        .img-box img { width: 100%; height: 100%; object-fit: cover; }

        .btn-add {
            background: var(--dark);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 8px 15px;
            font-weight: 600;
        }

        .btn-add:hover { background: var(--primary); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

    <nav class="navbar sticky-top">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand" href="/">JIRETH<span class="text-dark">STORE</span></a>
            
            <div class="d-flex align-items-center gap-3">
                <a href="/carrito" class="text-dark text-decoration-none position-relative">
                    <span style="font-size: 1.5rem;">🛒</span>
                    <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <%= cantidad %>
                    </span>
                </a>

                <div class="position-relative">
                    <button class="menu-btn" onclick="toggleMenu()">
                        <span></span><span></span><span></span>
                    </button>
                    <div id="myDropdown" class="dropdown-content">
                        <% if (user) { %>
                            <a href="#"><i class="fas fa-user"></i> Hola, <%= user %></a>
                            <a href="/logout"><i class="fas fa-sign-out-alt"></i> Salir</a>
                        <% } else { %>
                            <a href="/login"><i class="fas fa-sign-in-alt"></i> Ingresar</a>
                        <% } %>
                        <a href="/admin"><i class="fas fa-lock"></i> Admin</a>
                        <a href="https://wa.me/56948539049" target="_blank"><i class="fab fa-whatsapp"></i> WhatsApp</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mt-5">
        <div class="row g-4">
            <% productos.forEach(function(prod) { %>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="product-card h-100 d-flex flex-column">
                        <div class="img-box">
                            <img src="<%= prod.imagen %>" onerror="this.src='https://placehold.co/400x400?text=Jireth+Store'">
                        </div>
                        <div class="p-3 mt-auto text-center">
                            <h6 class="fw-bold mb-1"><%= prod.nombre %></h6>
                            <p class="text-primary fw-bold mb-2">$<%= prod.precio %></p>
                            <button class="btn-add w-100" onclick="add('<%= prod.id %>', '<%= prod.nombre %>', '<%= prod.precio %>')">
                                Agregar +
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>

    <script>
        function toggleMenu() {
            document.getElementById("myDropdown").classList.toggle("show");
        }

        // Cerrar menú si el usuario hace clic fuera
        window.onclick = function(event) {
            if (!event.target.matches('.menu-btn') && !event.target.matches('.menu-btn span')) {
                var dropdowns = document.getElementsByClassName("dropdown-content");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }

        function add(id, nombre, precio) {
            fetch('/agregar-al-carrito', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, nombre, precio })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('cart-count').innerText = data.cantidad;
            });
        }
    </script>
</body>
</html>