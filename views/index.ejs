<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Minimarket Jireth | Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --glass: rgba(255, 255, 255, 0.1); }
        body { background: #0f172a; color: white; }
        .card { background: #1e293b; border: none; transition: transform 0.3s; color: white; }
        .card:hover { transform: translateY(-10px); }
        .navbar { background: #1e293b !important; border-bottom: 1px solid #334155; }
        .footer-section { background: #1e293b; padding: 40px 0; border-top: 2px solid #22c55e; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold text-success" href="/">JIRETH TECH-STORE</a>
            <div class="d-flex align-items-center">
                <a href="/carrito" class="btn btn-success position-relative">
                    🛒 Carrito
                    <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <%= cantidad %>
                    </span>
                </a>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <h2 class="text-center mb-5 fw-bold">Nuestros Productos</h2>
        <div class="row">
            <% productos.forEach(function(prod) { %>
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow">
                        <img src="<%= prod.imagen %>" class="card-img-top" style="height:180px; object-fit:cover;">
                        <div class="card-body">
                            <span class="badge bg-success mb-2"><%= prod.categoria %></span>
                            <h5 class="card-title"><%= prod.nombre %></h5>
                            <h4 class="text-success">$<%= prod.precio %></h4>
                            <small class="text-muted">Stock: <%= prod.stock %></small>
                            <button class="btn btn-outline-success w-100 mt-3" onclick="add('<%= prod.id %>', '<%= prod.nombre %>', '<%= prod.precio %>')">Agregar</button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <section class="footer-section">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h4 class="text-success fw-bold">Visítanos</h4>
                    <p>📍 <strong>Dirección:</strong> <%= info.direccion %></p>
                    <p>⏰ <strong>Horarios:</strong> <%= info.horario %></p>
                    <p>📞 <strong>Contacto:</strong> <%= info.telefono %></p>
                    <iframe src="<%= info.mapa_url %>" width="100%" height="250" style="border:0; border-radius:15px;" allowfullscreen="" loading="lazy"></iframe>
                </div>
                <div class="col-md-6 text-center">
                    <h4 class="text-success fw-bold">Administración</h4>
                    <p>Acceso exclusivo para personal autorizado</p>
                    <a href="/admin" class="btn btn-secondary">Panel de Control</a>
                </div>
            </div>
        </div>
    </section>

    <script>
        function add(id, nombre, precio) {
            fetch('/agregar-al-carrito', {
                method: 'POST',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body: `id=${id}&nombre=${encodeURIComponent(nombre)}&precio=${precio}`
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('cart-count').innerText = data.cantidad;
            });
        }
    </script>
</body>
</html>