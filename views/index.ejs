<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Minimarket Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">🛒 Mi Minimarket Digital</a>
            <span class="text-white">Carrito: <span id="cart-count">0</span> ítems</span>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <% productos.forEach(function(prod) { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="<%= prod.image %>" class="card-img-top" alt="...">
                        <div class="card-body text-center">
                            <h5 class="card-title"><%= prod.nombre %></h5>
                            <p class="text-muted"><%= prod.categoria %></p>
                            <h4 class="text-success">$<%= prod.precio %></h4>
                            <p class="small text-secondary">Stock: <%= prod.stock %> unidades</p>
                            <button class="btn btn-outline-success" onclick="agregarAlCarrito('<%= prod.nombre %>')">
                                Agregar al pedido
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <script>
        let count = 0;
        function agregarAlCarrito(nombre) {
            count++;
            document.getElementById('cart-count').innerText = count;
            alert(nombre + " agregado correctamente");
        }
    </script>
</body>
</html>