<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimarket Jireth | Premium Store</title>
    
    <!-- Iconos y Fuentes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">

    <style>
        :root { 
            --primary: #10b981; 
            --dark: #0f172a;
            --light-bg: #f8fafc;
        }

        body { 
            background-color: var(--light-bg); 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            color: var(--dark); 
            overflow-x: hidden;
        }

        /* NAVBAR GLASSMORPHISM */
        .navbar { 
            background: rgba(255, 255, 255, 0.85); 
            backdrop-filter: blur(12px); 
            border-bottom: 1px solid rgba(16, 185, 129, 0.1);
            padding: 12px 0;
        }

        /* HERO COMPACTO */
        .hero-section {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-radius: 28px;
            padding: 35px;
            color: white;
            margin-bottom: 30px;
            position: relative;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .hero-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 10px 20px;
            border-radius: 14px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: 0.3s;
        }
        .hero-btn:hover { background: var(--primary); transform: translateY(-3px); color: white; }

        /* BURBUJA IA ASISTENTE */
        .ai-float {
            position: fixed;
            bottom: 25px;
            left: 25px;
            background: var(--dark);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            z-index: 2000;
            cursor: pointer;
            transition: 0.3s;
            border: 2px solid var(--primary);
        }
        .ai-float:hover { transform: scale(1.1); background: var(--primary); }

        /* WHATSAPP FLOAT */
        .whatsapp-float {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background-color: #25d366;
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            box-shadow: 0 10px 25px rgba(37,211,102,0.3);
            z-index: 2000;
            text-decoration: none;
        }

        /* TARJETAS DE PRODUCTO MEJORADAS */
        .product-card {
            background: white;
            border-radius: 24px;
            border: 1px solid rgba(0,0,0,0.03);
            transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            overflow: hidden;
            height: 100%;
        }
        .product-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); }

        /* 📸 TAMAÑO DE IMAGEN AUMENTADO Y EFECTO HOVER */
        .img-box { 
            height: 260px; 
            padding: 10px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            background: #fff; 
            overflow: hidden; 
        }
        .img-box img { 
            max-width: 100%; 
            max-height: 100%; 
            object-fit: contain; 
            transition: transform 0.4s ease; 
        }
        .product-card:hover .img-box img {
            transform: scale(1.1);
        }

        .btn-add {
            background: var(--dark); color: white; border: none;
            border-radius: 14px; padding: 12px; font-weight: 700; width: 100%;
            transition: 0.3s;
        }
        .btn-add:hover { background: var(--primary); }

        /* IA MODAL & CHAT */
        .modal-content { border-radius: 24px; border: none; }
        .chat-container { max-height: 400px; overflow-y: auto; padding-right: 10px; }
        .ai-message { background: #f8fafc; border: 1px solid #e2e8f0; padding: 16px; border-radius: 18px; margin-bottom: 15px; font-size: 0.95rem; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
        .ai-message-success { background: #f0fdf4; border: 1px solid #bbf7d0; }
        
        /* SCROLLBAR CUSTOM */
        .chat-container::-webkit-scrollbar { width: 6px; }
        .chat-container::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 10px; }

        /* MAPA */
        .map-container {
            border-radius: 28px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        }

        .dropdown-content {
            display: none; position: absolute; right: 0; top: 55px;
            background: white; min-width: 220px; border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1); z-index: 1000; overflow: hidden;
        }
        .dropdown-content.show { display: block; animation: fadeIn 0.3s; }
        .dropdown-content a { color: var(--dark); padding: 14px 20px; text-decoration: none; display: flex; align-items: center; gap: 12px; }
        .dropdown-content a:hover { background: #f0fdf4; color: var(--primary); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

    <!-- ASISTENTE IA BOTÓN -->
    <div class="ai-float" onclick="openAI()" title="Asistente de Compras">
        <i class="bi bi-robot"></i>
    </div>

    <!-- WHATSAPP BOTÓN -->
    <a href="https://wa.me/56948539049" class="whatsapp-float" target="_blank">
        <i class="fab fa-whatsapp"></i>
    </a>

    <!-- NAVBAR -->
    <nav class="navbar sticky-top">
        <div class="container d-flex justify-content-between align-items-center">
            
            <!-- 🚀 DISEÑO DE LOGO MODERNO -->
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
                <img src="/logo.png" height="42" onerror="this.src='https://placehold.co/42x42?text=J'" class="rounded-3 shadow-sm"> 
                <span class="mb-0" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                    <span class="fw-800 text-primary">JIRETH</span><span class="fw-light text-dark ms-1">STORE</span>
                </span>
            </a>
            
            <div class="d-flex align-items-center gap-3">
                <!-- 🛒 ICONO DE CARRITO DE SUPERMERCADO -->
                <a href="/carrito" class="text-dark text-decoration-none position-relative p-2 bg-light border shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; transition: 0.3s;" onmouseover="this.classList.add('bg-white')" onmouseout="this.classList.remove('bg-white')">
                    <i class="bi bi-cart3 fs-5"></i>
                    <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm" style="font-size: 0.65rem; border: 2px solid white;">
                        <%= cantidad %>
                    </span>
                </a>

                <div class="position-relative">
                    <button class="border-0 bg-transparent d-flex align-items-center justify-content-center p-2 rounded-circle hover-bg-light" style="width: 45px; height: 45px; transition: 0.3s;" onclick="toggleMenu()">
                        <i class="bi bi-grid-3x3-gap-fill fs-4 text-dark"></i>
                    </button>
                    <div id="myDropdown" class="dropdown-content">
                        <% if (locals.user) { %>
                            <a href="#"><i class="fas fa-user-circle"></i> Mi Perfil (<%= user %>)</a>
                            <a href="/logout"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</a>
                        <% } else { %>
                            <a href="/login"><i class="fas fa-sign-in-alt"></i> Iniciar Sesión</a>
                        <% } %>
                        <a href="/admin"><i class="bi bi-shield-lock"></i> Panel Admin</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        
        <!-- HERO SECTION COMPACTO CON SALUDO -->
        <div class="hero-section">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="badge bg-primary mb-2 rounded-pill">Premium Service</span>
                    
                    <!-- 👋 LÍNEAS NUEVAS DE BIENVENIDA -->
                    <% if (locals.user) { %>
                        <h3 class="mb-1 text-light fw-normal">¡Hola, <span class="fw-bold text-warning"><%= user %></span>! 👋</h3>
                    <% } %>
                    <!-- FIN LÍNEAS NUEVAS -->

                    <h1 class="mb-2 mt-2">Tu Minimarket <span class="text-primary">Inteligente</span></h1>
                    <p class="opacity-75 small mb-4">Compara precios, ahorra con nuestra IA y recibe en casa.</p>
                    
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#productos" class="hero-btn"><i class="bi bi-cart3"></i> Comprar Ahora</a>
                        <a href="javascript:void(0)" onclick="openAI()" class="hero-btn border-primary text-primary bg-white"><i class="bi bi-robot"></i> Usar IA de Ahorro Avanzada</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRILLA DE PRODUCTOS -->
        <div id="productos" class="row g-4 mb-5">
            <% productos.forEach(function(prod) { %>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="product-card d-flex flex-column">
                        <div class="img-box">
                            <!-- LÓGICA DE RUTAS REPARADA -->
                            <% 
                                let rutaImagen = prod.imagen || "";
                                if (!rutaImagen.startsWith('http')) {
                                    // Limpiamos errores comunes de tipeo
                                    rutaImagen = rutaImagen.replace(/^public\//, '');
                                    rutaImagen = rutaImagen.replace(/^\//, ''); 
                                    
                                    // Si no trae la ruta completa, se la inyectamos:
                                    if (!rutaImagen.startsWith('images/productos')) {
                                        rutaImagen = '/images/productos/' + rutaImagen;
                                    } else {
                                        rutaImagen = '/' + rutaImagen;
                                    }
                                }
                            %>
                            <img src="<%= rutaImagen %>" onerror="this.src='https://placehold.co/400x400?text=Producto+Jireth'">
                        </div>
                        <div class="p-3 mt-auto border-top border-light">
                            <h6 class="fw-bold mb-1 text-truncate" title="<%= prod.nombre %>"><%= prod.nombre %></h6>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-primary fw-800 fs-5">$<%= Number(prod.precio).toLocaleString('es-CL') %></span>
                                <span class="badge bg-light text-muted fw-normal border">Stock: <%= prod.stock %></span>
                            </div>
                            <button class="btn-add d-flex justify-content-center align-items-center gap-2" onclick="add('<%= prod.id %>', '<%= prod.nombre %>', '<%= prod.precio %>')">
                                <i class="bi bi-cart-plus fs-6"></i> Agregar
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- SECCIÓN MAPA MODERNO -->
        <div class="row mb-5 align-items-center">
            <div class="col-md-4 mb-4 mb-md-0">
                <h2 class="fw-800 mb-3">Estamos en el corazón de <span class="text-primary">Talagante</span></h2>
                <p class="text-muted">Visítanos y conoce nuestra gran variedad de productos frescos y de calidad.</p>
                <div class="p-3 bg-white border rounded-4 d-flex align-items-center gap-3 mb-3 shadow-sm">
                    <i class="bi bi-geo-alt-fill text-danger fs-3"></i>
                    <div>
                        <div class="small fw-bold text-muted">DIRECCIÓN</div>
                        <div class="fw-bold">Av. San Martin, Talagante</div>
                    </div>
                </div>
                <a href="https://maps.google.com/?q=Av+San+Martin,+Talagante" target="_blank" class="btn btn-dark w-100 rounded-pill py-2">Cómo llegar</a>
            </div>
            <div class="col-md-8">
                <div class="map-container">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3324.00000000000!2d-70.932824!3d-33.665809!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sAv.%20San%20Mart%C3%ADn%2C%20Talagante!5e0!3m2!1ses-419!2scl!4v1600000000000!5m2!1ses-419!2scl" 
                        width="100%" height="350" style="border:0; filter: grayscale(0.2) contrast(1.1);" allowfullscreen="" loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL DE ASISTENTE IA AVANZADA -->
    <div class="modal fade" id="aiModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0 pb-0 bg-dark text-white rounded-top-4 p-3">
                    <h5 class="modal-title fw-800 d-flex align-items-center gap-2">
                        <i class="bi bi-cpu fs-4 text-primary"></i> JirethBot 2.0 (IA Avanzada)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light">
                    <!-- Contenedor del Chat -->
                    <div id="aiContent" class="chat-container mb-3">
                        <!-- Generado por JS -->
                    </div>
                    
                    <div class="p-3 bg-white rounded-4 shadow-sm border">
                        <label class="form-label small fw-bold text-muted mb-2"><i class="bi bi-wallet2"></i> Optimizador de Presupuesto Múltiple</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">$</span>
                            <input type="number" id="budgetInput" class="form-control border-start-0 ps-0" placeholder="Ej: 8000" onkeypress="if(event.key === 'Enter') calculateBudget()">
                            <button class="btn btn-primary px-4 fw-bold" onclick="calculateBudget()">
                                <i class="bi bi-magic"></i> Optimizar
                            </button>
                        </div>
                        <div class="form-text mt-2" style="font-size: 0.75rem;">El algoritmo analizará todo el stock para armar la canasta más completa posible sin pasarse de tu dinero.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Convertimos los productos de EJS a un objeto JS para la IA
        const productosIA = JSON.parse('<%= JSON.stringify(productos) %>');

        function openAI() {
            const modal = new bootstrap.Modal(document.getElementById('aiModal'));
            const content = document.getElementById('aiContent');
            
            // Stats Inteligentes
            const totalProducts = productosIA.length;
            const categoriasUnicas =[...new Set(productosIA.map(p => p.categoria || 'Varios'))];
            
            content.innerHTML = `
                <div class="ai-message d-flex gap-3 align-items-start">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-circle">
                        <i class="bi bi-robot fs-3 text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">¡Hola! Soy la IA de Jireth. 🤖</h6>
                        <p class="mb-2 text-muted" style="font-size: 0.9rem;">He escaneado nuestra base de datos. Actualmente tenemos <b>${totalProducts} productos</b> divididos en <b>${categoriasUnicas.length} categorías</b>.</p>
                        <p class="mb-3 text-muted" style="font-size: 0.9rem;">¿Cómo te ayudo hoy? Escribe tu presupuesto abajo para armarte una canasta balanceada, o elige una recomendación rápida:</p>
                        
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-dark rounded-pill" onclick="suggestCombo('basico')">
                                <i class="bi bi-basket2"></i> Canasta Básica
                            </button>
                            <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="suggestCombo('snack')">
                                <i class="bi bi-controller"></i> Snacks y Bebidas
                            </button>
                        </div>
                    </div>
                </div>
            `;
            modal.show();
        }

        function calculateBudget() {
            const budget = parseInt(document.getElementById('budgetInput').value);
            const content = document.getElementById('aiContent');
            if(!budget || budget <= 0) return;

            let remaining = budget;
            let basket =[];
            let categoriasUsadas = new Set();
            
            let stockOrdenado =[...productosIA].sort((a, b) => a.precio - b.precio);

            for(let p of stockOrdenado) {
                let cat = p.categoria || 'Varios';
                if(p.precio <= remaining && !categoriasUsadas.has(cat)) {
                    basket.push(p);
                    remaining -= p.precio;
                    categoriasUsadas.add(cat);
                }
            }
            
            for(let p of stockOrdenado) {
                if(p.precio <= remaining && !basket.includes(p)) {
                    basket.push(p);
                    remaining -= p.precio;
                }
            }

            if(basket.length === 0) {
                let minimo = Math.min(...productosIA.map(p => p.precio));
                content.innerHTML += `
                    <div class="ai-message bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i> Lo siento, no encontré productos por $${budget}. Lo más económico que tenemos cuesta $${minimo}.
                    </div>
                `;
            } else {
                let totalUsado = budget - remaining;
                let basketJSON = JSON.stringify(basket).replace(/"/g, '&quot;');
                
                content.innerHTML += `
                    <div class="ai-message ai-message-success">
                        <h6 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill me-1"></i> Análisis Completado</h6>
                        <p class="mb-2 small">Con tu presupuesto de <b>$${budget}</b>, la IA ha creado esta combinación óptima usando <b>$${totalUsado}</b> (Sobran $${remaining}):</p>
                        
                        <div class="bg-white rounded-3 border p-2 mb-3">
                            ${basket.map(p => `
                                <div class="d-flex justify-content-between align-items-center py-1 border-bottom last-no-border">
                                    <span class="small fw-semibold text-dark">${p.nombre}</span>
                                    <span class="small text-muted">$${p.precio}</span>
                                </div>
                            `).join('')}
                        </div>
                        
                        <button class="btn btn-success w-100 fw-bold shadow-sm" onclick="addAllToCart(${basketJSON})">
                            <i class="bi bi-cart-plus-fill"></i> Llevar esta canasta al Carrito
                        </button>
                    </div>
                `;
            }
            
            document.getElementById('budgetInput').value = ''; 
            scrollToBottom();
        }

        function suggestCombo(tipo) {
             const content = document.getElementById('aiContent');
             let recomendados =[];
             let titulo = "";
             
             if (tipo === 'basico') {
                 titulo = "Canasta Básica Sugerida";
                 const keywords =['arroz', 'aceite', 'fideo', 'harina', 'huevo', 'leche'];
                 recomendados = productosIA.filter(p => keywords.some(k => p.nombre.toLowerCase().includes(k))).slice(0, 5);
             } else {
                 titulo = "Combo Fin de Semana";
                 const keywords =['bebida', 'coca', 'papa', 'galleta', 'snack', 'chocolate', 'ramita'];
                 recomendados = productosIA.filter(p => keywords.some(k => p.nombre.toLowerCase().includes(k))).slice(0, 4);
             }
             
             if(recomendados.length < 2) {
                 recomendados =[...productosIA].sort(() => 0.5 - Math.random()).slice(0, 4);
             }

             let totalCombo = recomendados.reduce((sum, p) => sum + p.precio, 0);
             let comboJSON = JSON.stringify(recomendados).replace(/"/g, '&quot;');

             content.innerHTML += `
                <div class="ai-message" style="border-left: 4px solid var(--primary);">
                    <h6 class="fw-bold"><i class="bi bi-stars text-warning me-1"></i> ${titulo}</h6>
                    <p class="small text-muted mb-2">Basado en preferencias populares. Total estimado: <b class="text-dark">$${totalCombo}</b></p>
                    
                    <ul class="list-unstyled mb-3 ps-2 border-start">
                        ${recomendados.map(p => `<li class="small py-1 text-secondary">• ${p.nombre} <span class="float-end fw-semibold text-dark">$${p.precio}</span></li>`).join('')}
                    </ul>
                    
                    <button class="btn btn-sm btn-outline-dark w-100" onclick="addAllToCart(${comboJSON})">
                        <i class="bi bi-cart-check"></i> Agregar Combo
                    </button>
                </div>
             `;
             scrollToBottom();
        }

        function addAllToCart(items) {
            items.forEach(item => add(item.id, item.nombre, item.precio));
            const content = document.getElementById('aiContent');
            content.innerHTML += `
                <div class="text-center text-success small fw-bold my-2 animate-fade">
                    <i class="bi bi-check2-all"></i> ¡Productos agregados al carrito exitosamente!
                </div>
            `;
            scrollToBottom();
        }

        function scrollToBottom() {
            const chat = document.getElementById('aiContent');
            chat.scrollTop = chat.scrollHeight;
        }

        function add(id, nombre, precio) {
            fetch('/agregar-al-carrito', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id, nombre, precio })
            })
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('cart-count');
                badge.innerText = data.cantidad;
                badge.style.transform = "scale(1.5)";
                setTimeout(() => badge.style.transform = "scale(1)", 200);
            });
        }

        function toggleMenu() {
            document.getElementById("myDropdown").classList.toggle("show");
        }

        window.onclick = function(event) {
            if (!event.target.closest('.position-relative')) {
                const drop = document.getElementById("myDropdown");
                if(drop.classList.contains('show')) drop.classList.remove('show');
            }
        }
    </script>
</body>
</html>